# --- Database ---
DATABASE_URL=postgresql+psycopg2://astrohelp:astrohelp@localhost:5434/astrohelp
TEST_DATABASE_URL=postgresql+psycopg2://astrohelp:astrohelp@localhost:5434/astrohelp_test

# --- Auth ---
# Admin-login tokens only (we sign and verify these ourselves). The astrologer
# side has no signing at all — the main AstroLokal app hands off a plain
# user_id in the webview URL, resolved against astrologers.user_id.
JWT_SECRET=dev-only-change-me
ADMIN_TOKEN_EXPIRE_HOURS=8

# No self-service signup or per-user reset — every admin logs in with the
# fixed password for the access_level an existing admin granted them.
NORMAL_ACCESS_PASSWORD=astroHelp@123
ADMIN_ACCESS_PASSWORD=astroHelpAdmin@123

# "production" on the production Secret, "dev" everywhere else — only used
# to build the Gemini billing label below.
ENVIRONMENT=dev

# --- Gemini (via Vertex AI — see the org's Vertex AI migration guide) ---
# No project id here — vertex_client reads it straight off the credential's
# own project_id field below.
GOOGLE_CLOUD_LOCATION=global
GEMINI_VERTEX_CREDENTIALS_JSON=
GEMINI_MODEL=gemini-flash-latest
# The "{environment}_{feature}" billing label's feature half — coordinate
# with other teams before changing this.
GEMINI_BILLING_FEATURE=supply_help

# --- Mocked integrations ---
# When true, every integration in app/integrations/ short-circuits before any
# real network call and returns fabricated (but plausible) data.
MOCK_MODE=true
N8N_MOCK_MODE=true
N8N_BEAUTIFY_FORM_URL=https://n8n.example.com/form/example-form-id
N8N_BEAUTIFY_LOG_SHEET_ID=
N8N_BEAUTIFY_LOG_TAB=Images
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/EXAMPLE/WEBHOOK/URL
SLACK_SUPPORT_CHANNEL=#support-test
ADMIN_DASHBOARD_URL=https://astro-supply-help-admin.astrolokal.com
SLACK_MOCK_MODE=true
# Bot Token (files:write scope, bot invited to the channel) — for pushing
# ticket photos/videos into Slack itself, not just a link. Channel ID, not name.
SLACK_BOT_TOKEN=
SLACK_UPLOAD_CHANNEL_ID=
EMAIL_MOCK_MODE=true

# Fired on every ticket status change (see app/integrations/moengage_client.py)
# — their dashboard campaigns decide which transitions push a notification.
MOENGAGE_MOCK_MODE=true
MOENGAGE_EVENT_API_URL=https://api-01.moengage.com/v1/event/{app_id}
MOENGAGE_APP_ID=
MOENGAGE_API_KEY=

# Zoho Desk two-way ticket sync (see app/integrations/zoho_client.py and
# app/api/routes/zoho_webhook.py). OAuth, not a static key — needs a client
# id/secret + refresh token from a Zoho API Console app (Desk.tickets.ALL
# scope). ZOHO_WEBHOOK_SECRET is a bearer secret you also set on the Zoho
# Desk workflow rule's webhook action header (X-Zoho-Webhook-Secret).
ZOHO_MOCK_MODE=true
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.in
ZOHO_API_DOMAIN=https://desk.zoho.in
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=
ZOHO_DEPARTMENT_ID=
ZOHO_WEBHOOK_SECRET=

# --- CORS ---
# Comma-separated list of origins allowed to call this API (both frontend dev servers).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Uploads / links back to the frontends ---
PUBLIC_BASE_URL=http://localhost:8000
ADMIN_APP_BASE_URL=http://localhost:5174

# --- Uploads storage backend ---
# "local" (default): disk, lost on redeploy/restart/scale-out. "s3": real,
# durable — bucket must have a policy allowing public s3:GetObject (not an
# ACL — most buckets now default to ACLs disabled).
UPLOADS_BACKEND=local
S3_BUCKET_NAME=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Google Sheets sync ---
# Service account JSON (Viewer access on both sheets) — see backend/credentials/,
# never committed. Sheet ids come from each sheet's URL. In a deployment with
# no file mount, set GOOGLE_SHEETS_CREDENTIALS_JSON instead (the file's raw
# or base64-encoded content) — it takes priority over the path when set.
GOOGLE_SHEETS_CREDENTIALS_PATH=credentials/google-sheets-service-account.json
GOOGLE_SHEETS_CREDENTIALS_JSON=
KYC_SPREADSHEET_ID=
PAYOUT_SPREADSHEET_ID=
PAYOUT_CYCLE_TAB=July 31 - 1

# --- Expert priority ranking (analytics query CSV, secret in the URL) ---
# Expected columns: expert_id, user_id, expert_name, current_priority, and
# (added 2026-08-19) astrologer_language — this is now the source of truth
# for Astrologer.language, which feeds ticket routing (KAM/CS language
# round-robin), not just cosmetic.
PRIORITY_QUERY_CSV_URL=
